# ── 앱(브라우저에 들어가는 공개 값) ─────────────────────────────────────────────
# 저장소의 .env 에 팀 Supabase 값이 들어 있다. 가짜 데이터(mock) 모드로 돌리려면 .env.local 에 두 값을 빈 값으로 적는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# ── 서버 비밀 값: 여기(앱)에 넣지 말고 Supabase Edge Function secrets 로 넣는다 ─────────
# npx supabase secrets set KEY=값 --project-ref <프로젝트ref>
#
# GEMINI_API_KEY=            # AI 공고 초안(draft-post) · 후속 질문·포트폴리오 초안(portfolio-ai)
# GEMINI_MODELS=             # 선택: 시도할 모델 순서 (쉼표)
# NOTION_CLIENT_ID=          # Notion public integration (docs/NOTION.md)
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=       # https://<프로젝트ref>.supabase.co/functions/v1/notion/callback
# NOTION_TOKEN_KEY=          # Notion 토큰 암호화 키: openssl rand -base64 32
# APP_ORIGINS=               # OAuth 후 돌아올 앱 주소들 (쉼표). 예: http://localhost:3000,https://wolgye.example.com
