# Browser-public Supabase credentials only. Leave empty for isolated mock mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# true면 위 Supabase 값이 있어도 사용자 전환이 가능한 mock 데모로 실행합니다.
NEXT_PUBLIC_DEMO_MODE=false

# NOTION_CLIENT_ID, NOTION_CLIENT_SECRET, NOTION_REDIRECT_URI,
# NOTION_TOKEN_KEY and APP_ORIGINS belong in Supabase Edge Function secrets.
# Never place service role / OAuth tokens in NEXT_PUBLIC_* variables.
